# One Cloudflare token shared by the authoritative parent and SaaS zones
CF_API_TOKEN=replace-with-token-valid-for-both-zones
CF_PARENT_ZONE_ID=replace-with-parent-zone-id
CF_PARENT_ZONE_NAME=example.com
CF_SAAS_ZONE_ID=replace-with-saas-zone-id
CF_FALLBACK_HOST=origin.example.com

# Tencent Cloud DNSPod
DNSPOD_SECRET_ID=replace-with-tencent-secret-id
DNSPOD_SECRET_KEY=replace-with-tencent-secret-key
DNSPOD_RECORD_LINE=默认
